# i3blocks/config
#
# Global properties
separator=false
separator_block_width=2
markup=pango
border_top=0
border_left=0
border_right=0
border_bottom=2
align=center

#[documentation]
#full_text=Documentation
#website=https://vivien.github.io/i3blocks
#command=xdg-open "$website"
#color=#f12711

#[greetings]
#command=echo "Hello, $USER!"
#interval=once
#

[archicon]
command=echo "󰣇"
min_width=40
color=#009999
interval=3600

[weather]
command=curl -m1 wttr.in?format=2 2>/dev/null
min_width=320
interval=1800
background=#666666
label=

[wan]
command=curl -4 ifconfig.me | xargs
min_width=280
interval=600
background=#666666
label=󰖈 

[lan]
command=hostname -i
min_width=210
interval=600
background=#666666
label=󰌘 

[cpufan]
command=$HOME/.config/i3blocks/cpufan
min_width=130
max_width=130
interval=1
background=#666666
label=󰈐 

[cpu]
command=$HOME/.config/i3blocks/cpu
min_width=130
max_width=130
align=center
interval=1
background=#666666
label= 

[memory]
command=free -h | awk '/^Mem/ {print $3"/"$2}' | sed 's/i//g'
min_width=210
max_width=210
interval=1
background=#666666
label= 

[time]
command=date +%H:%M
min_width=90
max_width=90
interval=1
background=#666666
